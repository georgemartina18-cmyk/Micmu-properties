{
  "name": "micmu-properties",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "test:worker": "node scripts/verify-worker.mjs",
    "format": "prettier --write app components lib tests scripts *.ts *.mjs *.json *.jsonc README.md docs/*.md"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@electric-sql/pglite": "0.5.11",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
