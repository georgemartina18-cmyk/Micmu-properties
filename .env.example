# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development-only samples. Ignored in production.
MICMU_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key for validated submissions. Never expose to browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Publishing/indexing stays off until content and legal review are complete.
MICMU_LAUNCH_APPROVED=false
